    "trim:plateau-asakusa": "dotnet run -c Release --project tools/TrimPlateauTileset/TrimPlateauTileset.csproj -- https://assets.cms.plateau.reearth.io/assets/75/76c6bc-df54-4bf4-a869-b513526b5bd2/13106_taito-ku_city_2025_citygml_1_op_bldg_3dtiles_lod2/tileset.json web/data/plateau-asakusa-bldg-lod2.json 139.787 35.707 139.804 35.723 17"
  }
}
